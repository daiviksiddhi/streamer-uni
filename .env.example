# Twitch Helix (required for the Twitch directory, live status, and clips)
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Kick Public API (optional)
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret

# YouTube Data API v3 (optional)
YOUTUBE_API_KEY=your_youtube_api_key

# Local JSON snapshot used only by `npm run wrapped:generate` (optional)
STREAMS_CHARTS_SOURCE=/absolute/path/to/streamcharts-snapshot.json
